# IHP Oman DeerFlow Environment Variables
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# LLM PROVIDERS
# ============================================================================
# Anthropic API (Claude Opus 5, Claude Sonnet 5)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (backup if needed)
OPENAI_API_KEY=sk-...

# ============================================================================
# WEB SEARCH (Optional - for market research)
# ============================================================================
TAVILY_API_KEY=tvly-...

# ============================================================================
# PORTAL INTEGRATIONS (Optional - Phase 2+)
# ============================================================================
# PDO Rabithah Portal
PDO_USERNAME=your-pdo-username
PDO_PASSWORD=your-pdo-password

# Tatweer / Business Gateways Portal
TATWEER_EMAIL=your-email@ihpoman.com
TATWEER_PASSWORD=your-tatweer-password

# ============================================================================
# EMAIL INTEGRATION (Optional - Phase 2+)
# ============================================================================
# Outlook/Microsoft 365
OUTLOOK_EMAIL=Sr.Sales@ihpoman.com
OUTLOOK_PASSWORD=your-outlook-password

# SMTP for email notifications
SMTP_HOST=smtp.outlook.com
SMTP_PORT=587
SMTP_USERNAME=Sr.Sales@ihpoman.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=Sr.Sales@ihpoman.com

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=sqlite:///.deer-flow/ihp_oman.db

# ============================================================================
# DEERFLOW
# ============================================================================
# DeerFlow port
DEERFLOW_PORT=2026
DEERFLOW_API_PORT=8001

# DeerFlow mode (development or production)
DEERFLOW_MODE=development

# ============================================================================
# NOTIFICATIONS
# ============================================================================
# Email recipients for alerts and daily briefs
ALERT_EMAIL=Hamed.h@ihpoman.com
CC_CRITICAL_EMAIL=Sr.Sales@ihpoman.com

# SMS (Optional)
SMS_ENABLED=false
SMS_PHONE=+968 9947 0222

# Slack (Optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================================================
# LANGSMITH (Optional - for advanced tracing)
# ============================================================================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=ihp-oman

# ============================================================================
# LOGGING & DEBUG
# ============================================================================
LOG_LEVEL=INFO
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================
# IHP Oman vendor code
IHP_VENDOR_CODE=106883

# PDO VDP threshold (critical)
PDO_VDP_THRESHOLD=90.0
PDO_VDP_CURRENT=68.96

# Deepak's email (operations escalation)
DEEPAK_EMAIL=deepak.email@ihpoman.com

# Hamed's email (strategic escalation)
HAMED_EMAIL=Hamed.h@ihpoman.com
